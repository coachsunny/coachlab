# DeepSeek API Key (可於 https://platform.deepseek.com 申請，格式為 sk-...)
DEEPSEEK_API_KEY=

# Google Gemini API Key (可於 https://aistudio.google.com/app/apikey 免費申請)
GEMINI_API_KEY=

# 伺服器連接埠 (預設 3000)
PORT=3000

# 預設使用的模型 (例如 deepseek-chat, gemini-3.6-flash, gemini-3.8-flash)
GEMINI_MODEL=gemini-3.6-flash
